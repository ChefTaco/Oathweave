{
  "name": "oathweave-workspace",
  "version": "2.3.0",
  "private": true,
  "description": "Oathweave identity API and middleware SDK",
  "type": "module",
  "engines": {
    "node": "^24.22.3 || ^26.13.1"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present && node --test scripts/check-node-runtime.test.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "iam-core:build": "npm --workspace @hivemagnus/oathweave run build",
    "iam-core:test": "npm --workspace @hivemagnus/oathweave test",
    "iam-sdk:build": "npm --workspace @hivemagnus/oathweave-sdk run build",
    "iam-sdk:test": "npm --workspace @hivemagnus/oathweave-sdk test",
    "deploy:iam-core": "bash scripts/deploy-iam-core.sh",
    "scan:secrets": "bash scripts/scan-secrets.sh",
    "check:private": "bash scripts/check-private-data.sh",
    "hooks:install": "git config core.hooksPath .githooks",
    "bootstrap": "npm ci --ignore-scripts && npm --prefix tooling/release ci --ignore-scripts && npm run hooks:install",
    "generate:openapi": "tsx scripts/openapi.ts --write",
    "check:openapi": "tsx scripts/openapi.ts",
    "test:bootstrap": "npm run build && node scripts/bootstrap-rehearsal.mjs",
    "contracts:browser": "node scripts/export-browser-contracts.mjs",
    "check:browser": "node scripts/export-browser-contracts.mjs --check"
  },
  "overrides": {
    "@hono/node-server": "2.1.6",
    "fast-uri": "3.1.9",
    "hono": "4.13.18",
    "npm": {
      "brace-expansion": "5.0.9",
      "ip-address": "10.4.0",
      "tar": "7.5.22",
      "undici": "7.29.0"
    },
    "valibot": "1.4.2",
    "mysql2": "3.24.3",
    "deepmerge-ts": "8.0.0",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "typescript": "6.0.3"
  }
}
