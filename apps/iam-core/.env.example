# ── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4200
HOST=0.0.0.0
MAX_REQUEST_BODY_BYTES=1048576
# Only these socket peers may supply X-Forwarded-For / X-Real-IP.
# Reverse proxies whose X-Forwarded-For is believed (addresses, CIDR ranges or IPv4 wildcards).
# List every proxy tier: the first address from the right that is not listed is the client.
TRUSTED_PROXY_IPS=127.0.0.1,::1,::ffff:127.0.0.1

# ── Database (SQLite) ────────────────────────────────────────────────────────
DATABASE_URL="file:./prisma/iam.db"

# ── Redis (local, namespaced) ─────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"
REDIS_PREFIX=hive-iam

# ── JWT (RS256) ────────────────────────────────────────────────────────────────
# Generate with: bash scripts/generate-keys.sh
JWT_PRIVATE_KEY_PATH=../certs/iam-private.pem
JWT_PUBLIC_KEY_PATH=../certs/iam-public.pem
# Comma-separated public keys retained until every token signed by them expires.
JWT_PREVIOUS_PUBLIC_KEY_PATHS=
JWT_ISSUER=iam-core
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# ── Session cookie (dashboard login) ──────────────────────────────────────────
COOKIE_SECRET=change_me_32_chars_minimum_secret_here

# ── TLS (Hono HTTPS) ──────────────────────────────────────────────────────────
TLS_CERT_PATH=../certs/server.crt
TLS_KEY_PATH=../certs/server.key

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGIN=https://localhost

# ── Audit log files (daily rotation) ─────────────────────────────────────────
AUDIT_LOG_DIR=./audit-logs
AUDIT_MAX_AGE_DAYS=365
AUDIT_FLUSH_INTERVAL_MS=5000
AUDIT_BATCH_SIZE=100

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_ATTEMPTS=5
# Testing only: raises sign-in, MFA and step-up throttles to 10000 attempts per
# window and stops failed attempts locking accounts. Same as `start --relax-auth-limits`.
RELAX_AUTH_LIMITS=false

# ── Agent shared secret ────────────────────────────────────────────────────────
IAM_AGENT_SECRET=change_me_agent_secret_hex_32_chars
# Required for first creation of the built-in confidential clients. Routine
# seeds preserve existing Argon2 hashes; rotate through POST /clients/:id/rotate-secret.
SEED_ADMIN_PASSWORD=change_me_admin_password_16_chars
SEED_HIVE_CLIENT_SECRET=change_me_hive_client_secret_32_chars
SEED_HIVE_ROUTER_CLIENT_SECRET=change_me_router_client_secret_32_chars
# Public base URL of the Hive control plane; used for the default redirect URIs.
SEED_HIVE_PUBLIC_URL=https://hive.example.com
SEED_HIVE_ROUTER_REDIRECT_URI=https://hive.example.com/api/auth/oidc/callback
# Optional secret for the read-only security-exporter client-credentials client.
# It receives only iam:audit:read and router:security-events:read.
SEED_SECURITY_EXPORTER_CLIENT_SECRET=
# Optional example OIDC client (example-portal). Leave the secret empty to skip it.
SEED_EXAMPLE_PORTAL_CLIENT_SECRET=
SEED_EXAMPLE_PORTAL_REDIRECT_URI=https://client.example.com/api/auth/callback/hive-iam

# ── Additional machine clients (optional) ─────────────────────────────────────
# JSON map of client ID → { audience, permissions, lifetimeSeconds, rotationOwner }.
# IAM_MACHINE_CLIENT_POLICIES={"my-api":{"audience":"my-api","permissions":["my-api:read"],"lifetimeSeconds":900,"rotationOwner":"platform-team"}}
# JSON map of client ID → secret (32 to 512 printable characters). Each start creates
# a listed client as a confidential client_credentials-only client and keeps its stored
# secret equal to this value. Every listed ID needs a policy above.
# IAM_MACHINE_CLIENT_SECRETS={"my-api":"<openssl rand -hex 32>"}

# Operator-owned releases default to explicit migrations and no background updates.
# Managed init writes its own opt-in settings; see UPGRADING.md.
HIVE_AUTO_MIGRATE=false
HIVE_UPDATE_CHECK=false
HIVE_AUTO_UPGRADE=false
HIVE_UI_UPGRADE=false
HIVE_COMPOSE_UPGRADE_SUPERVISOR=false

# Optional suite browser issuer and explicit resource permission ceilings.
IAM_BROWSER_ISSUER=
IAM_BROWSER_CLIENT_POLICIES={}
# Optional interactive discovery: set both URLs on the configured browser issuer origin.
# IAM_BROWSER_AUTHORIZATION_URL=https://identity.example.com/auth/authorize
# IAM_BROWSER_API_BASE_URL=https://identity.example.com/api/oathweave

# Browser passkeys: retain existing RP values when migrating registrations.
WEBAUTHN_RP_NAME=Oathweave
WEBAUTHN_RP_ID=console.example.com
WEBAUTHN_RP_ORIGIN=https://console.example.com
# Dedicated private delivery spool consumed by your trusted notification service.
# IAM_RECOVERY_OUTBOX_DIRECTORY=/data/recovery-outbox

# Optional, fresh stores only: protected product-owned browser client/initial ID contract.
# OATHWEAVE_SUITE_BOOTSTRAP_FILE=/config/suite-bootstrap.json

# Optional server-owned technical identity coordination; complete verified HTTPS API prefixes.
# IAM_ENROLLMENT_INSTALLATION_ID=example-installation
# IAM_ENROLLMENT_PRODUCTS_JSON={"emberpath":{"url":"https://models.example.com/api"},"hivemem":{"url":"https://memory.example.com/v1"}}

# Alternatively, a shared authority can coordinate explicit independent namespaces.
# IAM_ENROLLMENT_INSTALLATIONS_JSON={"example-installation":{"products":{"emberpath":{"url":"https://models.example.com/api"},"hivemem":{"url":"https://memory.example.com/v1"}},"operatorSubjects":["example-reviewed-subject"]}}
